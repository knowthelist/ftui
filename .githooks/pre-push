#!/bin/bash
# Ensure generated files match the commits being pushed.
# Activate once with: git config core.hooksPath .githooks

REPO_ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$REPO_ROOT" || exit 1

bash prepare_update.sh

if ! git diff --quiet HEAD -- controls_ftui.txt; then
  echo "controls_ftui.txt was regenerated and is not part of the commit being pushed." >&2
  echo "Commit the generated file, then run git push again." >&2
  git add controls_ftui.txt
  exit 1
fi

LATEST_SUBJECT=$(git log -1 --format=%s)
if [[ "$LATEST_SUBJECT" == Merge* ]]; then
  exit 0
fi

CHANGED_SUBJECT=$(git show HEAD:CHANGED 2>/dev/null | sed -n '2p')
if [[ "$CHANGED_SUBJECT" != "$LATEST_SUBJECT" ]]; then
  echo "CHANGED does not contain the latest commit subject." >&2
  echo "Run 'bash .githooks/post-commit', then push again." >&2
  exit 1
fi

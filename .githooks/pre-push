#!/bin/bash
# Ensure generated files match the commits being pushed.
# Activate once with: git config core.hooksPath .githooks

REPO_ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$REPO_ROOT" || exit 1

GENERATED_MANIFEST=$(mktemp "${TMPDIR:-/tmp}/controls_ftui.XXXXXX") || exit 1
COMMITTED_MANIFEST=$(mktemp "${TMPDIR:-/tmp}/controls_ftui.XXXXXX") || {
  rm -f "$GENERATED_MANIFEST"
  exit 1
}
trap 'rm -f "$GENERATED_MANIFEST" "$COMMITTED_MANIFEST"' EXIT

CONTROLS_FILE="$GENERATED_MANIFEST" bash prepare_update.sh >/dev/null
git show HEAD:controls_ftui.txt > "$COMMITTED_MANIFEST" || exit 1

# File mtimes can change after checkout. Compare stable manifest data only.
normalize_manifest() {
  sed -E 's/^((CRE|UPD) )[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}:[0-9]{2}:[0-9]{2} /\1/' "$1"
}

if ! diff -u <(normalize_manifest "$COMMITTED_MANIFEST") <(normalize_manifest "$GENERATED_MANIFEST") >/dev/null; then
  echo "controls_ftui.txt is stale in the commit being pushed." >&2
  echo "Run 'git add controls_ftui.txt && git commit' before pushing again." >&2
  git add controls_ftui.txt
  exit 1
fi

LATEST_SUBJECT=$(git log -1 --format=%s)
if [[ "$LATEST_SUBJECT" == Merge* ]]; then
  exit 0
fi

CHANGED_SUBJECT=$(git show HEAD:CHANGED 2>/dev/null | sed -n '2p')
if [[ "$CHANGED_SUBJECT" != "$LATEST_SUBJECT" ]]; then
  echo "CHANGED does not contain the latest commit subject." >&2
  echo "Run 'bash .githooks/post-commit', then push again." >&2
  exit 1
fi
